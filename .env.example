# PulseCheck production settings for docker-compose.yml.
# Copy to .env and fill in the REQUIRED values. Never commit .env.

# REQUIRED. Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# REQUIRED. Public address of this installation, without a trailing slash.
APP_URL=http://localhost
# REQUIRED. Database password (any long random string).
DB_PASSWORD=

# Port published on the host. Default: 80.
APP_PORT=80
# Set to true when PulseCheck is served over HTTPS (cookies are then sent only over HTTPS).
SESSION_SECURE_COOKIE=false
# Reverse proxies allowed to set X-Forwarded-* headers, comma separated (e.g. 172.16.0.0/12).
# Avoid *: with it, clients can fake their IP and bypass rate limits unless a proxy always overwrites the header.
# Leave empty when the web container is exposed directly.
TRUSTED_PROXIES=

DB_DATABASE=pulsecheck
DB_USERNAME=pulsecheck

# Number of queue workers running checks in parallel.
QUEUE_WORKERS=2
LOG_LEVEL=info

# Queues, cache and sessions use PostgreSQL by default.
# To use Redis: set REDIS_PASSWORD, change the three drivers to redis and start with
#   docker compose --profile redis up -d
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
REDIS_PASSWORD=

# Email, needed for password reset links. With "log" emails are only written to the logs.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=PulseCheck

# Set to false to stop new sign-ups once your account exists.
PULSECHECK_REGISTRATION_ENABLED=true

# Product limits.
PULSECHECK_MAX_MONITORS=20
PULSECHECK_HISTORY_RETENTION_DAYS=30
# Allow monitoring private/internal addresses. Keep false unless every user is trusted (see README).
PULSECHECK_ALLOW_PRIVATE_TARGETS=false

# Prebuilt images (optional). Leave as is to build locally.
APP_IMAGE=pulsecheck-app:latest
WEB_IMAGE=pulsecheck-web:latest
